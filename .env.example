# Base URL for the OpenAI-compatible chat completions endpoint.
API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Your API key. NEVER commit the real value; keep it in .env (gitignored).
API_KEY=sk-your-api-key-here

# Model used by the context guard (src/engine/guard.py).
# qwen3.6-flash is fast and cheap (good for quick iterations).
# qwen3.6-plus is the model the committed eval/results.json was generated with.
MODEL=qwen3.6-plus

# Number of concurrent worker threads used by `kivi eval` (eval/runner.py).
# Defaults to 20. Lower this (e.g. 7) if you hit upstream rate-limit backoff on a
# free/rate-limited API key; 20 is fine for review-grade keys with real quotas.
MAX_WORKERS=20

# Number of automatic retries per LLM API request (src/engine/guard.py).
# Defaults to 2. Raise this if you experience transient upstream failures; lower it
# if you want fail-fast behavior.
MAX_RETRIES=2